{
  "expo": {
    "name": "VizFitness",
    "slug": "vizfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vizfitness",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12100E",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#12100E",
      "resizeMode": "contain"
    },
    "platforms": ["android"],
    "android": {
      "package": "com.viz.fitness",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6F00"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_EXERCISE_ROUTES",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VizFitness usa tu ubicación para grabar la ruta de tus entrenamientos de cardio.",
          "locationAlwaysAndWhenInUsePermission": "VizFitness usa tu ubicación en segundo plano para seguir grabando la ruta con la pantalla apagada.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnect.js"
    ]
  }
}
